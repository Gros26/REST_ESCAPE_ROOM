# Copy this file to .env and keep your key only in your local environment.
GEMINI_API_KEY=your_gemini_api_key
# Optional. You can override the default model or provide a comma-separated fallback list.
GEMINI_MODEL=gemini-3.6-flash
# Optional. Secret used to sign the stateless X-Game-State token. If unset, a random one is generated per process.
# GAME_SIGNING_SECRET=some_long_random_string
